def call(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def webots_home(world="empty"):
    return select_webots(ROOT, world, os.environ.get("WEBOTS_HOME"))


def build_lockstep(home):
    """The flight bridge's per-step loop in C (controllers/flight_bridge/lockstep.c), compiled for each run (73 ms),
    so the run holds the loop it flew. Without a C compiler the bridge runs the same loop in Python; a source that
    does not compile stops the flight."""
    compiler = shutil.which("cc") or shutil.which("gcc")
    if compiler is None:
        return None
    with tempfile.TemporaryDirectory() as scratch:
        library = Path(scratch, "flight_lockstep.so")
        built = subprocess.run(
            [compiler, "-O2", "-shared", "-fPIC", str(ROOT / "controllers/flight_bridge/lockstep.c"),
             "-I", str(home / "include/controller/c"), "-L", str(home / "lib/controller"), "-lController",
             "-o", str(library)],
            capture_output=True, text=True,
        )
        if built.returncode:
            raise RuntimeError(f"The flight bridge's C loop does not compile. Fix controllers/flight_bridge/lockstep.c:\n"
                               f"{built.stderr}")
        return library.read_bytes()


def setup():
    for executable in ("docker", "uv"):
        if not shutil.which(executable):
            raise RuntimeError(f"Install {executable} before running ./ironlark setup.")
    call("docker", "build", "-t", IMAGE, str(ROOT / "docker"))
    call("docker", "build", "-t", ROS_IMAGE, str(ROOT / "ros"))
    CACHE.mkdir(exist_ok=True)
    stamp = CACHE / "ardupilot-commit"
    if not stamp.exists() or stamp.read_text().strip() != COMMIT:
        container = subprocess.check_output(
            ["docker", "create", IMAGE, "true"], text=True
        ).strip()
        try:
            call("docker", "cp", f"{container}:{UPSTREAM}", str(CACHE))
            call(
                "docker",
                "cp",
                f"{container}:/opt/ardupilot/COPYING.txt",
                str(CACHE / "ARDUPILOT-LICENSE.txt"),
            )
            stamp.write_text(COMMIT + "\n")
        finally:
            call("docker", "rm", container, stdout=subprocess.DEVNULL)
    if not (ROOT / ".venv/bin/python").exists():
        call("uv", "venv", "--python", "3.12.11", str(ROOT / ".venv"))
    call(
        "uv",
        "pip",
        "install",
        "--python",
        str(ROOT / ".venv/bin/python"),
        "numpy==2.2.6",
        "Pillow==12.3.0",
        "etcpak==0.9.15",
    )
    print("Setup complete. Run ./ironlark doctor, then ./ironlark run.")


