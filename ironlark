#!/usr/bin/env python3
"""Ironlark CLI: setup, doctor, simulated flights/missions, recording, replay, and verification."""

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from worlds import generate, textures  # noqa: E402

CACHE = ROOT / ".cache"
IMAGE = "ironlark-sitl:copter-4.7.1"
ROS_IMAGE = "ironlark-ros:humble"
ROS_TOPICS = ("/clock /imu/data /lidar/points /camera/image_raw /camera/camera_info /tf_static "
              "/ground_truth/pose /ground_truth/velocity")
ROS_BAG_OPTIONS = "--compression-mode message --compression-format zstd --compression-threads 2 --compression-queue-size 20000"
COMMIT = "dbe792162d06cab66c3475fd5556bf7a120f119e"
UPSTREAM = "/opt/ardupilot/libraries/SITL/examples/Webots_Python"


def call(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def webots_home():
    override = os.environ.get("WEBOTS_HOME")
    home = Path(override).resolve() if override else (ROOT / "webots").resolve()
    if override and not (home / "webots").is_file():
        raise RuntimeError(f"WEBOTS_HOME points to an invalid Webots install: {home}")
    return home


def ros_image_ready():
    return shutil.which("docker") is not None and subprocess.run(
        ["docker", "image", "inspect", ROS_IMAGE], stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL).returncode == 0


def require_ros_image():
    if not ros_image_ready():
        raise RuntimeError("ROS image unavailable; check Docker access and run ./ironlark setup.")


def setup():
    for executable in ("docker", "uv"):
        if not shutil.which(executable):
            raise RuntimeError(f"Install {executable} before running ./ironlark setup.")
    call("docker", "build", "-t", IMAGE, str(ROOT / "docker"))
    call("docker", "build", "-t", ROS_IMAGE, str(ROOT / "ros"))
    CACHE.mkdir(exist_ok=True)
    stamp = CACHE / "ardupilot-commit"
    if not stamp.exists() or stamp.read_text().strip() != COMMIT:
        container = subprocess.check_output(["docker", "create", IMAGE, "true"], text=True).strip()
        try:
            call("docker", "cp", f"{container}:{UPSTREAM}", str(CACHE))
            call("docker", "cp", f"{container}:/opt/ardupilot/COPYING.txt", str(CACHE / "ARDUPILOT-LICENSE.txt"))
            stamp.write_text(COMMIT + "\n")
        finally:
            call("docker", "rm", container, stdout=subprocess.DEVNULL)
    if not (ROOT / ".venv/bin/python").exists():
        call("uv", "venv", "--python", "3.12.11", str(ROOT / ".venv"))
    call("uv", "pip", "install", "--python", str(ROOT / ".venv/bin/python"), "numpy==2.2.6")
    print("Setup complete. Run ./ironlark doctor, then ./ironlark check or ./ironlark run.")


def doctor(overview=True, need_ros=False):
    home = webots_home()
    checks = {
        "Docker executable": shutil.which("docker") is not None,
        "Webots executable": (home / "webots").is_file() and os.access(home / "webots", os.X_OK),
        "Webots R2025a": (home / "resources/version.txt").is_file()
        and (home / "resources/version.txt").read_text().strip() == "R2025a",
        "Python environment": (ROOT / ".venv/bin/python").is_file(),
        "ArduPilot Webots assets": (CACHE / "Webots_Python/protos/Iris.proto").is_file(),
        "Pinned bridge version": (CACHE / "ardupilot-commit").is_file()
        and (CACHE / "ardupilot-commit").read_text().strip() == COMMIT,
    }
    if checks["Docker executable"]:
        checks["Docker daemon"] = subprocess.run(
            ["docker", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        checks["Built SITL image"] = subprocess.run(
            ["docker", "image", "inspect", IMAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if need_ros:
        checks["ROS 2 image (./ironlark setup)"] = ros_image_ready()
    for name, ok in checks.items():
        print(f"{'OK     ' if ok else 'MISSING'} {name}")
    ready = all(checks.values())
    if overview:
        print(f"{'OK     ' if ros_image_ready() else 'MISSING'} ROS 2 autonomy/recording image")
        print(f"{'OK     ' if shutil.which('xvfb-run') else 'MISSING'} Headless checks: xvfb-run")
        print(f"{'OK     ' if os.environ.get('DISPLAY') else 'MISSING'} Graphical run: X11/XWayland DISPLAY")
    if not ready:
        raise RuntimeError("Complete setup first. See README.md.")


def check_ports(ports=(5760, 5762, 9002, 9003)):
    for port in ports:
        kind = socket.SOCK_STREAM if port < 9000 else socket.SOCK_DGRAM
        with socket.socket(socket.AF_INET, kind) as probe:
            if kind == socket.SOCK_STREAM:
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                probe.bind(("127.0.0.1", port))
            except OSError as exc:
                raise RuntimeError(f"Port {port} is occupied. Stop the other simulation first.") from exc


def stop_process(proc):
    """Stop a process and its whole group: headless Webots outlives xvfb-run and ignores SIGTERM."""
    if proc is None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + 5.0
    while True:
        proc.poll()
        try:
            os.killpg(proc.pid, 0)
        except ProcessLookupError:
            break
        if time.monotonic() > deadline:
            os.killpg(proc.pid, signal.SIGKILL)
            break
        time.sleep(0.1)
    proc.wait()


def stage_world(run, world, seed):
    """Generate fresh IronlarkDrone.proto from config/sensors.json and stage the chosen world."""
    protos = run / "protos"
    protos.mkdir()
    sensors = json.loads((ROOT / "config/sensors.json").read_text())
    meshes_rel = os.path.relpath(CACHE / "Webots_Python/protos/meshes", protos)
    (protos / "IronlarkDrone.proto").write_text(generate.drone_proto(sensors, meshes_rel))

    worlds = run / "worlds"
    worlds.mkdir()
    if world == "empty":
        target = worlds / "flight_foundation.wbt"
        target.write_text((ROOT / "worlds/flight_foundation.wbt").read_text())
        shutil.copyfile(ROOT / "worlds/.flight_foundation.wbproj", worlds / ".flight_foundation.wbproj")
        return target, None
    tex_dir = textures.ensure_textures(CACHE)
    (worlds / "textures").symlink_to(tex_dir, target_is_directory=True)
    if world == "forest":
        target = worlds / "forest.wbt"
        target.write_text(generate.forest_world(seed=seed, tex_url="textures"))
        return target, None
    wbt, sim_meta = generate.build_mission_world(world, seed=seed, tex_url="textures")
    target = worlds / f"{world}.wbt"
    target.write_text(wbt)
    # sim-meta.json is read only by flight_observer & mission_eval; mission-brief.json is what autonomy sees.
    (run / "sim-meta.json").write_text(json.dumps(sim_meta, indent=2) + "\n")
    (run / "mission-brief.json").write_text(json.dumps(sim_meta["mission_brief"], indent=2) + "\n")
    return target, sim_meta


def sensing_cost(run):
    lines = re.findall(r"sensing: .* at (\d+) s, wall ([\d.]+)", (run / "webots.log").read_text(errors="replace"))
    if len(lines) < 2:
        return {}
    (sim0, wall0), (sim1, wall1) = lines[0], lines[-1]
    simulated, wall = int(sim1) - int(sim0), float(wall1) - float(wall0)
    if simulated <= 0 or wall <= 0:
        return {}
    return {
        "simulated_s": simulated,
        "wall_s": round(wall, 2),
        "realtime_factor": round(simulated / wall, 3),
        "added_wall_time": round(max(0.0, wall / simulated - 1.0), 3),
    }


def sensing_report(run):
    path = run / "sensing.json"
    return json.loads(path.read_text()) if path.exists() else None


def sensing_losses(report):
    losses = [report["failure"]] if report["failure"] else []
    if report["dropped"]:
        losses.append(f"{report['dropped']} messages dropped on a full queue")
    if report["sent"] < report["queued"]:
        losses.append(f"{report['queued'] - report['sent']} queued messages never sent")
    if report["acknowledged"] is not None and report["acknowledged"] != report["sent"]:
        losses.append(f"the ROS bridge read {report['acknowledged']} of {report['sent']} messages")
    elif report["acknowledged"] is None and not report["failure"]:
        losses.append("the ROS bridge never acknowledged the stream")
    return losses


def end_sensing(run, processes):
    (run / "sensing-end").touch()
    deadline = time.monotonic() + 60.0
    while (report := sensing_report(run)) is None:
        if any(p is not None and p.poll() is not None for p in processes):
            raise RuntimeError(f"A simulator process exited before sensing ended. Inspect {run}.")
        if time.monotonic() > deadline:
            raise RuntimeError(f"Sensing did not end within 60 s. Inspect {run / 'webots.log'} and {run / 'ros.log'}.")
        time.sleep(0.1)
    if losses := sensing_losses(report):
        raise RuntimeError(f"Recording incomplete: {'; '.join(losses)}. Inspect {run}.")
    return report


def ros_container(name, run, command):
    return [
        "docker", "run", "--rm", "--name", name, "--network", "host",
        "--user", f"{os.getuid()}:{os.getgid()}",
        "-e", "HOME=/tmp", "-e", "ROS_LOCALHOST_ONLY=1", "-e", "ROS_LOG_DIR=/run/ironlark/ros-log",
        "--mount", f"type=bind,src={ROOT},dst=/project,readonly",
        "--mount", f"type=bind,src={run},dst=/run/ironlark",
        ROS_IMAGE, "bash", "-c", "source /opt/ros/humble/setup.bash && " + command,
    ]


def replay(run):
    run = Path(run).resolve()
    if not (run / "bag").is_dir():
        raise RuntimeError(f"No bag in {run}. Record one with ./ironlark run --record.")
    require_ros_image()
    call(*ros_container(f"ironlark-replay-{os.getpid()}", run, "ros2 bag info bag && ros2 bag play bag"))


def check_replay(run):
    run = Path(run).resolve()
    require_ros_image()
    call(*ros_container(f"ironlark-replay-check-{os.getpid()}", run, "python3 /project/tools/check_replay.py /run/ironlark"))


def check_recording(run):
    run = Path(run).resolve()
    require_ros_image()
    call(*ros_container(f"ironlark-check-{os.getpid()}", run, "python3 /project/tools/check_recording.py /run/ironlark"))


@contextlib.contextmanager
def exclusive():
    CACHE.mkdir(exist_ok=True)
    with (CACHE / "flight.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("Another Ironlark flight is already running.") from exc
        yield


def flight(headless, editor=False, world="mission", seed=7, record=False, standby=False, gcs_port=8080):
    autonomy = world in generate.MISSION_WORLDS
    need_ros = record or autonomy
    interactive = autonomy and not headless
    doctor(overview=False, need_ros=need_ros)
    home = webots_home()
    if not headless and not os.environ.get("DISPLAY"):
        raise RuntimeError("Webots R2025a needs an X11/XWayland DISPLAY; use ./ironlark check for headless.")
    if headless and not shutil.which("xvfb-run"):
        raise RuntimeError("Headless checks require xvfb-run.")

    with exclusive():
        check_ports()
        run = ROOT / "runs" / (time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}")
        run.mkdir(parents=True)
        (run / "manifest.json").write_text(json.dumps({
            "ardupilot_commit": COMMIT,
            "webots": "R2025a",
            "estimator": "EKF3",
            "sitl_image_id": subprocess.check_output(["docker", "image", "inspect", "--format", "{{.Id}}", IMAGE],
                                                     text=True).strip(),
            "webots_clock_patch_sha256": hashlib.sha256((ROOT / "docker/webots-clock.patch").read_bytes()).hexdigest(),
            "mission": "outdoor-to-cave-exploration" if autonomy else "takeoff-hover-land",
            "headless": headless,
            "world": world,
            "seed": seed,
        }, indent=2) + "\n")
        print(f"Run folder: {run}", flush=True)

        env = os.environ.copy()
        env["WEBOTS_HOME"] = str(home)
        env["PATH"] = str(ROOT / ".venv/bin") + os.pathsep + env.get("PATH", "")
        env["PYTHONUNBUFFERED"] = "1"
        env["IRONLARK_RUN_DIR"] = str(run)
        if need_ros:
            env["IRONLARK_SENSING"] = "1"
        if not record:
            env["IRONLARK_FAST_START"] = "1"

        world_path, _ = stage_world(run, world, seed)
        (run / "controllers").symlink_to(ROOT / "controllers", target_is_directory=True)
        command = [str(home / "webots"), "--batch", "--mode=realtime", "--stdout", "--stderr"]
        if headless:
            env["QT_QPA_PLATFORM"] = "xcb"
            prefs = Path(env.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "Cyberbotics/Webots-R2025a.conf"
            private = run / "config/Cyberbotics"
            private.mkdir(parents=True)
            if prefs.is_file():
                shutil.copyfile(prefs, private / prefs.name)
            env["XDG_CONFIG_HOME"] = str(run / "config")
            command = ["xvfb-run", "-a", *command, "--no-rendering", "--minimize"]
        elif not editor:
            command.append("--fullscreen")
        command.append(str(world_path))

        sitl_name = f"ironlark-sitl-{os.getpid()}"
        ros_name = f"ironlark-ros-{os.getpid()}"
        webots = sitl = ros = mission = injector = None
        with (run / "webots.log").open("w") as webots_log, (run / "sitl.log").open("w") as sitl_log:
            try:
                if need_ros:
                    ros_cmd = "python3 /project/ros/ironlark_bridge.py & bridge=$!; "
                    if record:
                        ros_cmd += (f"ros2 bag record -o bag --qos-profile-overrides-path /project/ros/record_qos.yaml "
                                    f"{ROS_BAG_OPTIONS} {ROS_TOPICS} & recorder=$!; "
                                    "trap 'kill -INT $recorder; wait $recorder; kill $bridge' INT TERM; wait")
                    else:
                        ros_cmd += "trap 'kill $bridge' INT TERM; wait $bridge"
                    ros = subprocess.Popen(
                        ros_container(ros_name, run, ros_cmd),
                        stdout=(run / "ros.log").open("w"), stderr=subprocess.STDOUT, start_new_session=True,
                    )
                webots = subprocess.Popen(command, env=env, stdout=webots_log, stderr=subprocess.STDOUT,
                                          start_new_session=True)
                defaults = (f"/opt/ardupilot/Tools/autotest/default_params/copter.parm,"
                            f"{UPSTREAM}/params/iris.parm,/project/config/flight.parm"
                            + (",/project/config/external_nav.parm" if autonomy else ""))
                sitl = subprocess.Popen([
                    "docker", "run", "--rm", "--name", sitl_name, "--network", "host",
                    "--user", f"{os.getuid()}:{os.getgid()}",
                    "--mount", f"type=bind,src={ROOT},dst=/project,readonly",
                    "--mount", f"type=bind,src={run},dst=/run/ironlark",
                    IMAGE, "/opt/ardupilot/build/sitl/bin/arducopter",
                    "--model", "webots-python", "--speedup", "1", "--wipe",
                    "--home", "31.9500,35.9300,750,0",
                    "--defaults", defaults,
                    "--serial0", "tcp:5760", "--serial1", "tcp:5762", "--serial2", "none",
                    "--sim-address", "127.0.0.1",
                ], stdout=sitl_log, stderr=subprocess.STDOUT, start_new_session=True)

                # Wait for SITL (and ROS when needed) containers & Webots controllers to be ready.
                needed = [sitl_name] + ([ros_name] if need_ros else [])
                deadline = time.monotonic() + 30.0
                while time.monotonic() < deadline:
                    if webots.poll() is not None or sitl.poll() is not None:
                        raise RuntimeError(f"A simulator process exited. Inspect {run}.")
                    if all(
                        subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", cname],
                                       capture_output=True, text=True).stdout.strip() == "true"
                        for cname in needed
                    ):
                        break
                    time.sleep(0.2)
                else:
                    raise RuntimeError("Simulator containers did not start within 30 s.")

                deadline = time.monotonic() + 120.0
                while not (run / "world-ready").exists():
                    if webots.poll() is not None or sitl.poll() is not None:
                        raise RuntimeError(f"A simulator process exited while loading. Inspect {run}.")
                    if time.monotonic() > deadline:
                        raise RuntimeError(f"World did not load within 120 s. Inspect {run}.")
                    time.sleep(0.2)

                if autonomy:
                    injector = subprocess.Popen(
                        ["docker", "exec", sitl_name, "python3", "/project/tools/sim_gps_zone.py",
                         "/run/ironlark"],
                        start_new_session=True,
                    )
                    flags = (f" --interactive --gcs-port {gcs_port}" + (" --standby" if standby else "")) if interactive else ""
                    if interactive:
                        print(f"Supervisory GCS: http://127.0.0.1:{gcs_port}  (Webots keys: 1 Chase, 2 Tail, 3 Overview, 4 Free)",
                              flush=True)
                    mission = subprocess.Popen(
                        ["docker", "exec", ros_name, "bash", "-c",
                         "source /opt/ros/humble/setup.bash && python3 /project/autonomy/mission.py "
                         f"--run /run/ironlark --brief /run/ironlark/mission-brief.json{flags}"],
                        start_new_session=True,
                    )
                else:
                    mission = subprocess.Popen(
                        ["docker", "exec", sitl_name, "python3", "/project/tests/flight_smoke.py",
                         "--output", "/run/ironlark/result.json"],
                        start_new_session=True,
                    )

                deadline = time.monotonic() + (86400.0 if interactive else 900.0)
                while mission.poll() is None:
                    if webots.poll() is not None or sitl.poll() is not None:
                        if interactive:
                            break  # user closed Webots cleanly
                        raise RuntimeError(f"A simulator process exited during flight. Inspect {run}.")
                    if record and (stream := sensing_report(run)):
                        raise RuntimeError(f"Sensing failed during flight: {'; '.join(sensing_losses(stream))}.")
                    if time.monotonic() > deadline:
                        raise RuntimeError(f"Flight exceeded wall-clock backstop. Inspect {run}.")
                    time.sleep(0.2)

                if autonomy and not interactive:
                    (run / "mission-done").touch()
                    if injector is not None:
                        injector.wait(timeout=10)
                    verdict = subprocess.run(
                        ["docker", "exec", sitl_name, "python3", "/project/tests/mission_eval.py",
                         "--judge", "/run/ironlark"],
                    )
                    if mission.returncode or verdict.returncode:
                        raise RuntimeError(f"Autonomous mission check failed. Inspect {run}.")
                    print(f"PASS: outdoor-to-cave GPS-denied autonomous mission. Report: {run / 'result.json'}")
                elif not autonomy:
                    if mission.returncode:
                        raise RuntimeError(f"Flight check failed. Inspect {run}.")
                    print(f"PASS: takeoff, hover, landing. Report: {run / 'result.json'}")

                if record:
                    report = json.loads((run / "result.json").read_text())
                    stream = end_sensing(run, (webots, sitl, ros))
                    report["sensing"] = {**stream, **(cost := sensing_cost(run))}
                    (run / "result.json").write_text(json.dumps(report, indent=2) + "\n")
                    print(f"Sensing: {stream['sent']} messages, all acknowledged"
                          + (f" ({cost['realtime_factor']}x real time)" if cost else ""))
                if not headless:
                    print("World left open. Ctrl+C to exit.", flush=True)
                    webots.wait()
            finally:
                (run / "mission-done").touch()
                if ros is not None:
                    subprocess.run(["docker", "kill", "--signal", "INT", ros_name],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    try:
                        ros.wait(timeout=20)
                    except subprocess.TimeoutExpired:
                        stop_process(ros)
                stop_process(injector)
                stop_process(mission)
                subprocess.run(["docker", "stop", "--time", "3", sitl_name],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                stop_process(sitl)
                stop_process(webots)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("setup", "doctor", "run", "check", "replay", "check-recording", "check-replay"))
    parser.add_argument("run_dir", nargs="?", help="replay/check-recording/check-replay: a run folder (runs/...)")
    parser.add_argument("--world", choices=(*generate.MISSION_WORLDS, "forest", "empty"), default=None,
                        help="world to fly: mission, warehouse, canyon, compound, forest, empty (defaults: mission for run, empty for check)")
    parser.add_argument("--seed", type=int, default=7, help="procedural world seed (default: 7)")
    parser.add_argument("--record", action="store_true", help="record all ROS 2 sensor topics to rosbag2")
    parser.add_argument("--editor", action="store_true", help="show Webots development UI (run only)")
    parser.add_argument("--standby", action="store_true", help="run: boot on pad and wait for Supervisory GCS commands")
    parser.add_argument("--gcs-port", type=int, default=8080, help="run: Supervisory GCS HTTP port (default: 8080)")
    args = parser.parse_args()

    if args.editor and args.command != "run":
        parser.error("--editor is only available with run")
    if args.standby and args.command != "run":
        parser.error("--standby is only available with run")
    if args.command in ("replay", "check-recording", "check-replay"):
        if not args.run_dir:
            parser.error(f"{args.command} needs a run folder")
        {"replay": replay, "check-recording": check_recording, "check-replay": check_replay}[args.command](args.run_dir)
    elif args.command == "setup":
        setup()
    elif args.command == "doctor":
        doctor()
    else:
        world = args.world or ("empty" if args.command == "check" else "mission")
        flight(headless=args.command == "check", editor=args.editor, world=world, seed=args.seed,
               record=args.record, standby=args.standby, gcs_port=args.gcs_port)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nSimulation stopped.", file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        print(f"Ironlark: {error}", file=sys.stderr)
        sys.exit(1)
