        "Docker executable": shutil.which("docker") is not None,
        "Webots executable": (home / "webots").is_file() and os.access(home / "webots", os.X_OK),
        "Webots R2025a": (home / "resources/version.txt").is_file()
        and (home / "resources/version.txt").read_text().strip() == "R2025a",
        "Python environment": (ROOT / ".venv/bin/python").is_file(),
        "ArduPilot Webots assets": (
            CACHE / "Webots_Python/protos/Iris.proto"
        ).is_file(),
        "Pinned bridge version": (CACHE / "ardupilot-commit").is_file()
        and (CACHE / "ardupilot-commit").read_text().strip() == COMMIT,
    }
    if checks["Docker executable"]:
        checks["Docker daemon"] = (
            subprocess.run(
                ["docker", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).returncode
            == 0
        )
        checks["Built SITL image"] = (
            subprocess.run(
                ["docker", "image", "inspect", IMAGE],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            == 0
        )
    if record:
        checks["ROS recording/replay image (./ironlark setup)"] = ros_image_ready()
    for name, ok in checks.items():
        print(f"{'OK     ' if ok else 'MISSING'} {name}")
    runtime_ready = all(checks.values())
    if selection_error:
        print(selection_error)
        runtime_ready = False
    if overview:
        print(f"{'OK     ' if runtime_ready else 'MISSING'} General runtime readiness (./ironlark setup)")
        print(preflight_report(renderer_preflight()))
        selected = Path(os.environ["WEBOTS_HOME"]).resolve() if os.environ.get("WEBOTS_HOME") else CACHE / "webots-renderer"
