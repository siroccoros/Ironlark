+// a standard normal deviate (Box-Muller)
+static float gaussian(void) {
+    const float u1 = 0.5f * (1.0f - rand_float());  // (0, 1]
+    const float u2 = 0.5f * (1.0f + rand_float());
+    return sqrtf(-2.0f * logf(u1)) * cosf(2.0f * M_PI * u2);
+}
+
+// a sensor's white noise of density nsd for samples at rate_hz (bandwidth rate_hz / 2), each axis
+static Vector3f white_noise(float nsd, float rate_hz) {
+    return Vector3f{gaussian(), gaussian(), gaussian()} * (nsd * sqrtf(0.5f * rate_hz));
+}
+
+// the rate of nsamples sub-samples over the time since the last sample (a driver averages its FIFO over that):
+// the simulation steps when it does, not at the sensor's rate
+static float sub_sample_rate(uint64_t &last_us, uint16_t sample_hz, uint8_t nsamples) {
+    const uint64_t now = AP_HAL::micros64();
+    const float interval = last_us != 0 && now > last_us ? (now - last_us) * 1.0e-6f : 1.0f / sample_hz;
+    last_us = now;
+    return nsamples / interval;
+}
+
 // calculate a noisy noise component
 static float calculate_noise(float noise, float noise_variation) {
     return noise * (1.0f + noise_variation * rand_float());
