diff --git a/resources/wren/shaders/encode_depth.frag b/resources/wren/shaders/encode_depth.frag
index c7d4f638edefe57ce956f1f45b6b5b87dd51a2fb..eb3ef5a247cd09257f8129bf8317ece15b84c907 100644
--- a/resources/wren/shaders/encode_depth.frag
+++ b/resources/wren/shaders/encode_depth.frag
@@ -9,8 +9,12 @@ layout(location = 1) out float outputDepth;
 
 uniform float minRange;
 uniform float maxRange;
+// A panorama's reach (0: none): its range, as a distance from the camera (merge_spherical.frag), so a fragment past it
+// shows nothing; it is left undrawn, as the instances wholly past it are (Renderable::collectVisibleInstances).
+uniform float reach;
 
 in float distToCamera;
+in vec3 viewCoord;
 in vec2 texUv;
 
 // Alpha-masked materials (PBR alphaCutoff) cut the same texels out of range images as out of the
@@ -33,6 +37,9 @@ layout(std140) uniform PbrMaterial {
 material;
 
 void main() {
+  if (reach > 0.0 && dot(viewCoord, viewCoord) >= reach * reach)
+    discard;
+
   if (alphaMasked && material.alphaCutoff.x > 0.0 && material.baseColorRoughnessMetalnessOcclusionMapFlags.x > 0.0) {
     vec2 texel = texUv * vec2(textureSize(inputTextures[0], 0));
     float mip = max(0.0, 0.5 * log2(max(dot(dFdx(texel), dFdx(texel)), dot(dFdy(texel), dFdy(texel)))));
diff --git a/resources/wren/shaders/encode_depth.vert b/resources/wren/shaders/encode_depth.vert
index 35ef9deb5f515d91c29f61a999243c48c37e0a26..2223e6ca4826e4f3312621df6ebf868abb64a063 100644
--- a/resources/wren/shaders/encode_depth.vert
+++ b/resources/wren/shaders/encode_depth.vert
@@ -7,6 +7,7 @@ layout(location = 0) in vec3 vCoord;
 layout(location = 2) in vec2 vTexCoord;
 
 out float distToCamera;
+out vec3 viewCoord;  // for the reach, a distance from the camera
 out vec2 texUv;
 
 #ifdef INSTANCED
@@ -36,6 +37,7 @@ void main() {
 #endif
 
   distToCamera = -vCoordTransformed.z;
+  viewCoord = vCoordTransformed.xyz;
   texUv = vTexCoord;
 
   gl_Position = cameraTransforms.projection * vCoordTransformed;
