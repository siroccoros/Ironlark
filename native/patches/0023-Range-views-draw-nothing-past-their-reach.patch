index 89d2c394fee49ea8d6120ef0783f49309900b348..3846d2c6af12f3c25605242eaf3c6f11a8e002d6 100644
--- a/src/webots/wren/WbWrenCamera.cpp
+++ b/src/webots/wren/WbWrenCamera.cpp
@@ -53,6 +53,9 @@
 #include <QtCore/QTime>
 #include <QtGui/QImageReader>
 
+#include <cstdlib>
+#include <cstring>
+
 #define DOF_FAR_BLUR_CUTOFF 1.5f
 #define DOF_BLUR_TEXTURE_RESOLUTION 320.0f
 
@@ -436,6 +439,16 @@ void WbWrenCamera::render() {
                                                  reinterpret_cast<const char *>(&mMinRange));
       wr_shader_program_set_custom_uniform_value(program, "maxRange", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
                                                  reinterpret_cast<const char *>(&mMaxRange));
+      // A panorama's pixels read its range as a distance from the camera (merge_spherical.frag): past that reach
+      // nothing shows, so nothing past it is drawn. IRONLARK_RANGE_REACH=0 draws the instances anyway (comparisons).
+      const float reach = isPlanarProjection() ? 0.0f : mMaxRange;
+      wr_shader_program_set_custom_uniform_value(program, "reach", WR_SHADER_PROGRAM_UNIFORM_TYPE_FLOAT,
+                                                 reinterpret_cast<const char *>(&reach));
+    }
+    static const bool cullPastReach = !getenv("IRONLARK_RANGE_REACH") || strcmp(getenv("IRONLARK_RANGE_REACH"), "0");
+    for (int i = 0; i < CAMERA_ORIENTATION_COUNT; ++i) {
+      if (mIsCameraActive[i])
+        wr_camera_set_reach(mCamera[i], cullPastReach && !isPlanarProjection() ? mMaxRange : 0.0f);
     }
   }
 
