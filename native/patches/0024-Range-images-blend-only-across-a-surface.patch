From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaid <283011337+nottzaid@users.noreply.github.com>
Date: Fri, 30 Oct 2026 05:06:53 +0300
Subject: [PATCH] Range images blend only across a surface

A spherical or cylindrical range image samples its sub-cameras between
texels and blends the four around it that vary least. Where all four
straddle a depth edge (a trunk's silhouette, a needle card, the robot's
own propellers against the ground) the blend is a range between the
two surfaces, on neither: a point in the air. Such blends now take the
nearest texel, as the blend already did beside a texel that saw
nothing: a range image's texels blend only when within 2% of the
nearest one's range, what a plane at 85 degrees of incidence spans a
texel apart (0.0014 rad for a Lidar's sub-cameras). The one-dimensional
blends (a single row or column) follow the same rule. Colour images are
unchanged.

Measured (forest flight, the Mid-360's 3600 x 1047 panorama, its
returns against the meshes the world draws: Ironlark's
tools/check_recording.py): returns farther from every surface than 4
times the rig's noise spread 4.62% -> 0.035% of 20,000.
---
 resources/wren/shaders/merge_spherical.frag | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/resources/wren/shaders/merge_spherical.frag b/resources/wren/shaders/merge_spherical.frag
index 7cc1578a451b2856e642d71e9cd12e9de6679195..a7b917ffeb4ac4faf4a66baada0ceb76aca3bde4 100644
--- a/resources/wren/shaders/merge_spherical.frag
+++ b/resources/wren/shaders/merge_spherical.frag
@@ -22,6 +22,9 @@ in vec2 texUv;
 out vec4 fragColor;
 
 uniform bool rangeCamera;
+// How far apart neighbouring texels' ranges lie on one surface, over the range: a plane at 85 degrees of incidence,
+// texels 0.0014 rad apart (Lidar sub-cameras), spans tan(85 deg) x 0.0014 = 0.016.
+const float EDGE = 0.02;
 uniform bool cylindrical;
 
 uniform float maxRange;
@@ -102,7 +105,10 @@ vec4 textureSmooth(sampler2D tex, vec2 p, int bias) {
     vec4 c10 = texelFetch(tex, pixelCoord + ivec2(0, ySide), bias);
     vec4 c11 = texelFetch(tex, pixelCoord + ivec2(xSide, ySide), bias);
 
-    if (isinf(c00.x) || isinf(c01.x) || isinf(c10.x) || isinf(c11.x))
+    // Ranges blend only across a surface: a blend across a depth edge (more than a plane at 85 degrees of
+    // incidence spans, a texel apart) is a point between the two, on neither.
+    float spread = max(abs(c01.x - c00.x), max(abs(c10.x - c00.x), abs(c11.x - c00.x)));
+    if (isinf(c00.x) || isinf(c01.x) || isinf(c10.x) || isinf(c11.x) || (rangeCamera && spread > EDGE * c00.x))
       return c00;
     else {
       vec4 c0 = c00 + (c01 - c00) * dx * xSide;
@@ -123,7 +129,7 @@ vec4 textureSmooth(sampler2D tex, vec2 p, int bias) {
 
     vec4 c0 = texelFetch(tex, pixelCoord, bias);
     vec4 c1 = texelFetch(tex, pixelCoord + ivec2(xSide, 0), bias);
-    if (isinf(c0.x) || isinf(c1.x))
+    if (isinf(c0.x) || isinf(c1.x) || (rangeCamera && abs(c1.x - c0.x) > EDGE * c0.x))
       return c0;
     else
       return c0 + (c1 - c0) * dx;
@@ -136,7 +142,7 @@ vec4 textureSmooth(sampler2D tex, vec2 p, int bias) {
 
     vec4 c0 = texelFetch(tex, pixelCoord, bias);
     vec4 c1 = texelFetch(tex, pixelCoord + ivec2(0, ySide), bias);
-    if (isinf(c0.x) || isinf(c1.x))
+    if (isinf(c0.x) || isinf(c1.x) || (rangeCamera && abs(c1.x - c0.x) > EDGE * c0.x))
       return c0;
     else
       return c0 + (c1 - c0) * dy;
